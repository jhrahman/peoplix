NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Upstash Redis (free tier). Caching/rate-limiting are pure
# optimizations - the app runs fine with these unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: GIF search in comments (GIPHY). Create a free API key at
# https://developers.giphy.com (the free "beta" key allows about 100 calls an
# hour - results are cached for an hour to stay within that). Without it the
# GIF button explains that search isn't set up; everything else keeps working.
GIPHY_API_KEY=
